  /// `null` clears an optional one. (A getter of a function type, so that leaving a parameter out
  /// and passing `null` differ without a parameter's type widening: `copyWith(page: null)`.)
  {{ r.name }}Route Function({ {%- for f in r.fields %}{{ f.ty }} {{ f.name }}{{ ", " if not loop.last }}{% endfor -%} }) get copyWith => _copyWith;

  {{ r.name }}Route _copyWith({ {%- for f in r.fields %}Object? {{ f.name }} = _keep{{ ", " if not loop.last }}{% endfor -%} }) =>
      {{ r.name }}Route({% for f in r.fields %}{{ f.name }}: _kept<{{ f.ty }}>({{ f.name }}, this.{{ f.name }}){{ ", " if not loop.last }}{% endfor %});
{% endif %}
{% if r.data %}

{% if r.data.optimistic %}
  /// Watches {{ r.data.file }}, with the `optimistic()` patches of the writes in flight: an `AsyncValue`, typed by inference (static, so it can name the keys). Since 0.8.1.
  static final watch = (WidgetRef ref{{ r.data.args }}) => ref.watchOptimistic(data{{ r.data.key }}, {{ r.data.optimistic }});
{% else %}
  /// Watches {{ r.data.file }}: an `AsyncValue`, typed by inference (static, so it can name the keys).
  static final watch = (WidgetRef ref{{ r.data.args }}) => ref.watch(data{{ r.data.key }});
{% endif %}

  /// Reads {{ r.data.file }} once, keeping it alive until it completes.
  static final read = (WidgetRef ref{{ r.data.args }}) => ref.{{ "readSelected" if r.data.selector else "readData" }}(data{{ r.data.key }});

  /// Starts loading {{ r.data.file }} before navigating; kept alive until the handle is closed (or `keepFor` passes).
  PrefetchHandle prefetch(WidgetRef ref, {Duration? keepFor}) => ref.prefetchData(data{{ r.data.key }}, keepFor: keepFor);

  /// {{ r.data.verb }} {{ r.data.file }}; completes with the fresh value.
{% if r.data.selector %}
  Future<void> refresh(WidgetRef ref) => ref.refreshSelected(data{{ r.data.key }});
{% else %}
  Future<void> refresh(WidgetRef ref) => ref.refresh(data{{ r.data.key }}.future);
{% endif %}
{% endif %}
{% if r.code and r.preload %}

  /// Starts loading everything this page reads (the data of each section above it, then its own: `AppRoutes.dataAt(location)`), kept alive until the handle is closed (or `keepFor` passes), and its code ({{ r.file }} is deferred). Never navigates, runs no guard.
  @override
  PrefetchHandle preload(WidgetRef ref, {Duration? keepFor}) {
    {{ r.code }}.preload();
    return ref.prefetchAll([{{ r.preload }}], keepFor: keepFor);
  }
{% elif r.code %}

  /// Starts loading this page's code ({{ r.file }} is deferred); it reads no data, so the handle holds nothing. Never navigates, runs no guard.
  @override
  PrefetchHandle preload(WidgetRef ref, {Duration? keepFor}) {
    {{ r.code }}.preload();
    return ref.prefetchAll(const [], keepFor: keepFor);
  }
{% elif r.preload %}

  /// Starts loading everything this page reads (the data of each section above it, then its own: `AppRoutes.dataAt(location)`), kept alive until the handle is closed (or `keepFor` passes). Never navigates, runs no guard.
  @override
  PrefetchHandle preload(WidgetRef ref, {Duration? keepFor}) => ref.prefetchAll([{{ r.preload }}], keepFor: keepFor);
{% endif %}
