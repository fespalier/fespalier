{% macro action_members(a) %}
  /// The state of `{{ a.name }}()` ({{ a.file }}){{ a.keyed }}: `AsyncValue<T?>`, idle (`AsyncData(null)`) until it runs, then loading, the error or the result. An action never replaces the page with `error.dart` and is never retried.
  static final {{ a.provider }} = {{ a.top }};

  /// Runs `{{ a.name }}()` once; after a success, the data it made stale (by default the data.dart of this folder and the sections above it, or what `invalidates` lists) is invalidated. {{ a.returns }}; the error is in the state as well.
  static final {{ a.run }} = (WidgetRef ref, {{ a.params }}) => ref.{{ a.run_with }}({{ a.provider }}{{ a.key }}, input);

  /// Watches the state of `{{ a.name }}()` and gives `call(input)` to run it, for `build`. A failed run is in `state`, not thrown.
  static final {{ a.hook }} = (WidgetRef ref{{ a.hook_params }}) => ref.{{ a.watch_with }}({{ a.provider }}{{ a.key }});
{%- if a.form %}


  /// The form of `{{ a.name }}()` ({{ a.file }}){{ a.keyed }}, for `build` in a `HookConsumerWidget`: a typed field per field of its input, starting from `{{ a.form.function }}({{ "data" if a.form.has_data }})`; `onSubmit` checks the fields{{ " and `" ~ a.form.validate ~ "()`" if a.form.validate }}, then runs it, and is null while it runs. Since 0.8.1.
  static final {{ a.form.hook }} = (WidgetRef ref, {{ a.form.params }}) => useActionForm(ref, {{ a.provider }}{{ a.key }}, {{ a.form.args }});
{%- endif %}
{%- endmacro %}
{% macro trace_data(p) -%}
{% if telemetry -%}
traceDataCall(ref, '{{ p.site }}', {{ p.key_expr }}, () => {{ p.call }}, telemetry: const TelemetrySite({{ p.site_file }}, route: {{ p.site_route }}))
{%- else -%}
traceData(ref, '{{ p.site }}', {{ p.key_expr }}, {{ p.call }})
{%- endif %}
{%- endmacro %}
{% macro view(b) -%}
{% if b.data -%}
DataView(
  watch: (ref) => watchData(ref, '{{ b.data.site }}', {{ b.data.provider }}),
  refresh: (ref) => {{ b.data.invalidate }},
  data: (d) => {{ b.page | indent(2) }},
  loading: () => {{ b.data.loading }},
  error: (e, st, retry) => {{ b.data.error }},
  keepPrevious: {{ "true" if keep_previous else "false" }},
{% if b.data.optimistic %}
  optimistic: (ref) => ref.watch({{ b.data.optimistic }}),
{% endif %}
{% if b.data.keep_data_on_error %}
  keepDataOnError: true,
{% endif %}
{% if b.data.library %}
  library: {{ b.data.library }},
{% endif %}
)
{%- else -%}
{{ b.page }}
{%- endif %}
{%- endmacro %}
{% macro with_segments(seg_fn, body, not_found) -%}
buildWithParams(
  () => {{ seg_fn }}(state),
  (v) => {{ body | indent(2) }},
  () => {{ not_found }},
)
{%- endmacro %}
{% macro guard_with_segments(seg_fn, call) -%}
guardWithParams(
  () => {{ seg_fn }}(state),
  (v) => {{ call }},
)
{%- endmacro %}
{% macro leave_scope(page) -%}
leaveScope(state, {{ page }})
{%- endmacro %}
{% macro scroll_memory(page) -%}
RouteScrollMemory(
  state: state,
  child: {{ page | indent(2) }},
)
{%- endmacro %}
{% macro with_transition(t, page) -%}
{{ t.call }}(
{% for a in t.args %}
  {{ a.prefix }}{{ (a.value or page) | indent(2) }},
{% endfor %}
)
{%- endmacro %}
{% macro redirect_call(c) -%}
traceGuard(state, '{{ c.site }}', {{ guard_with_segments(c.seg_fn, c.call) if c.seg_fn else c.call }}{{ ", telemetry: const TelemetrySite(" ~ c.site_file ~ ", route: " ~ c.site_route ~ ")" if telemetry }})
{%- endmacro %}
{% macro layout_call(l) -%}
{{ (with_segments(l.seg_fn, view(l), l.not_found) if l.seg_fn else view(l)) | indent(2) }}
{%- endmacro %}
{% macro layout_body(l) -%}
{{ (with_segments(l.seg_fn, view(l), l.not_found) if l.seg_fn else view(l)) | indent(2) }}
{%- endmacro %}
{% macro layout_page(l) -%}
{% if l.transition -%}
{{ with_transition(l.transition, layout_body(l)) }}
{%- else -%}
layoutPage(
  context,
  state,
  {{ l.restoration_id }},
  {{ layout_body(l) }},
)
{%- endif %}
{%- endmacro %}
{% macro route(r) -%}
{% if r.branches -%}
{% if r.container -%}
StatefulShellRoute(
  navigatorContainerBuilder: {{ r.container }},
{% else -%}
StatefulShellRoute.indexedStack(
{% endif %}
{% if r.root %}
  parentNavigatorKey: rootNavigatorKey,
{% endif %}
  pageBuilder: (context, state, navigationShell) => namedPage({{ r.layout.page_name }}, () => {{ layout_page(r.layout) | indent(2) }}),
  branches: [
{% for b in r.branches %}
    StatefulShellBranch(
{% if b.initial_location %}
      initialLocation: {{ b.initial_location }},
{% endif %}
{% if b.preload %}
      preload: true,
{% endif %}
      routes: [
{% for c in b.routes %}
        {{ route(c) | indent(8) }},
{% endfor %}
      ],
      restorationScopeId: {{ b.restoration_id }},
    ),
{% endfor %}
  ],
  restorationScopeId: {{ r.layout.restoration_id }},
)
{%- elif r.layout -%}
ShellRoute(
{% if r.root %}
  parentNavigatorKey: rootNavigatorKey,
{% endif %}
  pageBuilder: (context, state, child) => namedPage({{ r.layout.page_name }}, () => {{ layout_page(r.layout) | indent(2) }}),
  routes: [
{% for c in r.routes %}
    {{ route(c) | indent(4) }},
{% endfor %}
  ],
  restorationScopeId: {{ r.layout.restoration_id }},
)
{%- else -%}
GoRoute(
  path: {{ r.path }},
{% if r.root %}
  parentNavigatorKey: rootNavigatorKey,
{% endif %}
{% if not r.case_sensitive %}
  caseSensitive: false,
{% endif %}
{% if r.redirects | length == 1 %}
  redirect: (context, state) => {{ redirect_call(r.redirects[0]) | indent(2) }},
{% elif r.redirects %}
  redirect: (context, state) => firstRedirect([
{% for c in r.redirects %}
    () => {{ redirect_call(c) | indent(4) }},
{% endfor %}
  ]),
{% endif %}
{% if r.leave %}
  onExit: (context, state) => {{ r.leave | indent(2) }},
{% endif %}
{% if r.page %}
{% set body = leave_scope(view(r)) if r.leave else view(r) %}
{% set page = with_segments(r.seg_fn, body, r.not_found) if r.seg_fn else body %}
{% if scroll_restoration %}
{% set page = scroll_memory(page) %}
{% endif %}
{% if r.transition %}
  pageBuilder: (context, state) => namedPage({{ r.page_name }}, () => {{ with_transition(r.transition, page) | indent(2) }}),
{% elif r.remount %}
  pageBuilder: (context, state) => namedPage({{ r.page_name }}, () => remountPage(
    context,
    state,
    remountKey(state, {{ r.remount }}),
    {{ page | indent(4) }},
  )),
{% else %}
  builder: (context, state) => {{ page | indent(2) }},
{% endif %}
{% elif r.not_found_builder %}
  builder: (context, state) => {{ r.not_found }},
{% endif %}
{% if r.routes %}
  routes: [
{% for c in r.routes %}
    {{ route(c) | indent(4) }},
{% endfor %}
  ],
{% endif %}
)
{%- endif %}
{%- endmacro -%}
