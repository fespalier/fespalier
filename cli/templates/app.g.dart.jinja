{#- lib/app.g.dart. Expressions (widget calls, paths) are worked out in emit.rs;
    this template owns the shape of the file. -#}
{% macro view(b) -%}
{% if b.data -%}
DataView(
  watch: (ref) => ref.watch({{ b.data.provider }}),
  refresh: (ref) => {{ b.data.invalidate }},
  data: (d) => {{ b.page | indent(2) }},
  loading: () => {{ b.data.loading }},
  error: (e, st, retry) => {{ b.data.error }},
  keepPrevious: {{ "true" if keep_previous else "false" }},
)
{%- else -%}
{{ b.page }}
{%- endif %}
{%- endmacro %}
{% macro with_segments(seg_fn, body, not_found) -%}
buildWithParams(
  () => {{ seg_fn }}(state),
  (v) => {{ body | indent(2) }},
  () => {{ not_found }},
)
{%- endmacro %}
{% macro guard_with_segments(seg_fn, call) -%}
guardWithParams(
  () => {{ seg_fn }}(state),
  (v) => {{ call }},
)
{%- endmacro %}
{% macro with_transition(t, page) -%}
{{ t.call }}(
{% for a in t.args %}
  {{ a.prefix }}{{ (a.value or page) | indent(2) }},
{% endfor %}
)
{%- endmacro %}
{% macro redirect_call(c) -%}
{{ guard_with_segments(c.seg_fn, c.call) if c.seg_fn else c.call }}
{%- endmacro %}
{% macro layout_call(l) -%}
{{ (with_segments(l.seg_fn, view(l), l.not_found) if l.seg_fn else view(l)) | indent(2) }}
{%- endmacro %}
{% macro route(r) -%}
{% if r.branches -%}
StatefulShellRoute.indexedStack(
  builder: (context, state, navigationShell) => {{ layout_call(r.layout) }},
  branches: [
{% for b in r.branches %}
    StatefulShellBranch(
{% if b.initial_location %}
      initialLocation: {{ b.initial_location }},
{% endif %}
{% if b.preload %}
      preload: true,
{% endif %}
      routes: [
{% for c in b.routes %}
        {{ route(c) | indent(8) }},
{% endfor %}
      ],
    ),
{% endfor %}
  ],
)
{%- elif r.layout -%}
ShellRoute(
  builder: (context, state, child) => {{ layout_call(r.layout) }},
  routes: [
{% for c in r.routes %}
    {{ route(c) | indent(4) }},
{% endfor %}
  ],
)
{%- else -%}
GoRoute(
  path: {{ r.path }},
{% if not case_sensitive %}
  caseSensitive: false,
{% endif %}
{% if r.redirects | length == 1 %}
  redirect: (context, state) => {{ redirect_call(r.redirects[0]) | indent(2) }},
{% elif r.redirects %}
  redirect: (context, state) => firstRedirect([
{% for c in r.redirects %}
    () => {{ redirect_call(c) | indent(4) }},
{% endfor %}
  ]),
{% endif %}
{% if r.page %}
{% set page = with_segments(r.seg_fn, view(r), r.not_found) if r.seg_fn else view(r) %}
{% if r.transition %}
  pageBuilder: (context, state) => {{ with_transition(r.transition, page) | indent(2) }},
{% else %}
  builder: (context, state) => {{ page | indent(2) }},
{% endif %}
{% elif r.not_found_builder %}
  builder: (context, state) => {{ r.not_found }},
{% endif %}
{% if r.routes %}
  routes: [
{% for c in r.routes %}
    {{ route(c) | indent(4) }},
{% endfor %}
  ],
{% endif %}
)
{%- endif %}
{%- endmacro -%}
