{% endfor %}

import 'package:fespalier/fespalier.dart';
import 'package:flutter/widgets.dart';

{% for i in imports %}
import '{{ i }}' as _i{{ loop.index0 }};
{% endfor %}
{% for i in extra_imports %}
{{ i }}
{% endfor %}

/// The file tree under {{ app_dir }}/, ready to mount.
abstract final class AppRoutes {
  static String _base = '/';

  /// Where the tree is mounted: '/' standalone, or the `at` given to [mount].
  static String get base => _base;

  /// A standalone router for `MaterialApp.router(routerConfig: ...)`.
  static GoRouter router({
    String initialLocation = '/',
    List<NavigatorObserver>? observers,
  }) =>
      GoRouter(
        initialLocation: initialLocation,
        observers: observers,
        routes: mount(),
        errorBuilder: (context, state) => notFound(state.uri),
      );

  /// The routes alone, to embed in an existing GoRouter under [at].
  static List<RouteBase> mount({String at = '/'}) {
    _base = at;
    return [
{% for r in tree %}
      {{ route(r) | indent(6) }},
{% endfor %}
    ];
  }

{% if not_founds %}
  /// The not_found.dart nearest to [uri]: the deepest folder whose path it is under.
  static Widget notFound(Uri uri) => nearestNotFound(
        uri,
        base,
        [
{% for n in not_founds %}
          ({{ n.prefix }}, (uri) => {{ n.call }}),
{% endfor %}
        ],
        (uri) => {{ not_found }},
{% if not case_sensitive %}
        caseSensitive: false,
{% endif %}
      );
{% else %}
  static Widget notFound(Uri uri) => {{ not_found }};
{% endif %}
}
{% for r in routes %}

/// `{{ r.pattern }}` → {{ r.file }}
final class {{ r.name }}Route extends TypedLocation {
{% if r.fields %}
  const {{ r.name }}Route({ {%- for f in r.fields %}{{ f.param }}{{ ", " if not loop.last }}{% endfor -%} });

{% for f in r.fields %}
  final {{ f.ty }} {{ f.name }};
{% endfor %}
{% else %}
  const {{ r.name }}Route();
{% endif %}
{% if r.data %}

  /// {{ r.data.file }} as a Riverpod provider{{ r.data.keyed }}.
  static final data = {{ r.data.expr }};
{% endif %}

{% if r.location_assert %}
  @override
  String get location {
    {{ r.location_assert }};
    return {{ r.location }};
  }
{% else %}
  @override
  String get location => {{ r.location }};
{% endif %}
{% if r.extra %}

  /// Navigates here with an `extra`: an object that isn't in the URL, so a deep link or a reload leaves it null.
  @override
  void go(BuildContext context, { {{- r.extra }} extra}) => context.go(location, extra: extra);

  @override
  Future<T?> push<T extends Object?>(BuildContext context, { {{- r.extra }} extra}) =>
      context.push<T>(location, extra: extra);

  @override
  void replace(BuildContext context, { {{- r.extra }} extra}) => context.replace(location, extra: extra);
{% endif %}
{% if r.data %}

  /// Watches {{ r.data.file }}: an `AsyncValue`, typed by inference (static, so it can name the keys).
  static final watch = (WidgetRef ref{{ r.data.args }}) => ref.watch(data{{ r.data.key }});

  /// Reads {{ r.data.file }} once, keeping it alive until it completes.
  static final read = (WidgetRef ref{{ r.data.args }}) => ref.{{ "readSelected" if r.data.selector else "readData" }}(data{{ r.data.key }});

  /// Starts loading {{ r.data.file }} before navigating; kept for `keepFor` (default 30 s).
  void prefetch(WidgetRef ref, {Duration? keepFor}) => ref.prefetchData(data{{ r.data.key }}, keepFor: keepFor);

  /// {{ r.data.verb }} {{ r.data.file }}; completes with the fresh value.
{% if r.data.selector %}
  Future<void> refresh(WidgetRef ref) => ref.refreshSelected(data{{ r.data.key }});
{% else %}
  Future<void> refresh(WidgetRef ref) => ref.refresh(data{{ r.data.key }}.future);
{% endif %}
{% endif %}
}
{% endfor %}
{% for f in params_fns %}

{{ f.record }} {{ f.name }}(GoRouterState s) => {{ f.parse }};
{% endfor %}
{% for p in providers %}
{% if p.selector and p.family %}

/// data.dart selects the app's own provider: nothing wraps it (a closure, so its type is inferred).
final _data{{ p.id }} = ({{ p.params }}) => {{ p.call }};
{% elif p.selector %}

/// data.dart selects the app's own provider: nothing wraps it.
final _data{{ p.id }} = {{ p.call }};
{% else %}

final _data{{ p.id }} = {{ p.kind }}.autoDispose{{ ".family" if p.family }}(
  ({{ p.params }}) => {{ p.call }},
{% if p.no_retry %}
  // No automatic retry: error.dart and its Retry button are the retry UX.
  retry: (retryCount, error) => null,
{% endif %}
);
{% endif %}
{% endfor %}
