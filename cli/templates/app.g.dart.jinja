{#- lib/app.g.dart. Expressions (widget calls, paths) are worked out in emit.rs;
    this template owns the shape of the file. -#}
{% macro view(b) -%}
{% if b.data -%}
DataView(
  watch: (ref) => ref.watch({{ b.data.provider }}),
  refresh: (ref) => ref.invalidate({{ b.data.provider }}),
  data: (d) => {{ b.page }},
  loading: () => {{ b.data.loading }},
  error: (e, st, retry) => {{ b.data.error }},
)
{%- else -%}
{{ b.page }}
{%- endif %}
{%- endmacro %}
{% macro with_segments(seg_fn, body) -%}
buildWithSegments(
  () => {{ seg_fn }}(state),
  (v) => {{ body | indent(2) }},
  () => notFound(state.uri),
)
{%- endmacro %}
{% macro guard_with_segments(seg_fn, call) -%}
guardWithSegments(
  () => {{ seg_fn }}(state),
  (v) => {{ call }},
)
{%- endmacro %}
{% macro route(r) -%}
{% if r.layout -%}
ShellRoute(
  builder: (context, state, child) => {{ (with_segments(r.layout.seg_fn, r.layout.call) if r.layout.seg_fn else r.layout.call) | indent(2) }},
  routes: [
{% for c in r.routes %}
    {{ route(c) | indent(4) }},
{% endfor %}
  ],
)
{%- else -%}
GoRoute(
  path: {{ r.path }},
{% if r.redirect %}
  redirect: (context, state) => {{ (guard_with_segments(r.redirect.seg_fn, r.redirect.call) if r.redirect.seg_fn else r.redirect.call) | indent(2) }},
{% endif %}
  builder: (context, state) => {{ (with_segments(r.seg_fn, view(r)) if r.seg_fn else view(r)) | indent(2) }},
{% if r.routes %}
  routes: [
{% for c in r.routes %}
    {{ route(c) | indent(4) }},
{% endfor %}
  ],
{% endif %}
)
{%- endif %}
{%- endmacro -%}
