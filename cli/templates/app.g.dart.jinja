{#- lib/app.g.dart. Expressions (widget calls, paths) are worked out in emit.rs;
    this template owns the shape of the file. -#}
{% macro view(b) -%}
{% if b.data -%}
DataView(
  watch: (ref) => ref.watch({{ b.data.provider }}),
  refresh: (ref) => ref.invalidate({{ b.data.provider }}),
  data: (d) => {{ b.page }},
  loading: () => {{ b.data.loading }},
  error: (e, st, retry) => {{ b.data.error }},
)
{%- else -%}
{{ b.page }}
{%- endif %}
{%- endmacro %}
{% macro with_segments(seg_fn, body) -%}
buildWithParams(
  () => {{ seg_fn }}(state),
  (v) => {{ body | indent(2) }},
  () => notFound(state.uri),
)
{%- endmacro %}
{% macro guard_with_segments(seg_fn, call) -%}
guardWithParams(
  () => {{ seg_fn }}(state),
  (v) => {{ call }},
)
{%- endmacro %}
{% macro with_transition(t, page) -%}
{{ t.call }}(
{% for a in t.args %}
  {{ a.prefix }}{{ (a.value or page) | indent(2) }},
{% endfor %}
)
{%- endmacro %}
{% macro layout_call(l) -%}
{{ (with_segments(l.seg_fn, l.call) if l.seg_fn else l.call) | indent(2) }}
{%- endmacro %}
{% macro route(r) -%}
{% if r.branches -%}
StatefulShellRoute.indexedStack(
  builder: (context, state, navigationShell) => {{ layout_call(r.layout) }},
  branches: [
{% for b in r.branches %}
    StatefulShellBranch(
{% if b.initial_location %}
      initialLocation: {{ b.initial_location }},
{% endif %}
{% if b.preload %}
      preload: true,
{% endif %}
      routes: [
{% for c in b.routes %}
        {{ route(c) | indent(8) }},
{% endfor %}
      ],
    ),
{% endfor %}
  ],
)
{%- elif r.layout -%}
ShellRoute(
  builder: (context, state, child) => {{ layout_call(r.layout) }},
  routes: [
{% for c in r.routes %}
    {{ route(c) | indent(4) }},
{% endfor %}
  ],
)
{%- else -%}
GoRoute(
  path: {{ r.path }},
{% if r.redirect %}
  redirect: (context, state) => {{ (guard_with_segments(r.redirect.seg_fn, r.redirect.call) if r.redirect.seg_fn else r.redirect.call) | indent(2) }},
{% endif %}
{% set page = with_segments(r.seg_fn, view(r)) if r.seg_fn else view(r) %}
{% if r.transition %}
  pageBuilder: (context, state) => {{ with_transition(r.transition, page) | indent(2) }},
{% else %}
  builder: (context, state) => {{ page | indent(2) }},
{% endif %}
{% if r.routes %}
  routes: [
{% for c in r.routes %}
    {{ route(c) | indent(4) }},
{% endfor %}
  ],
{% endif %}
)
{%- endif %}
{%- endmacro -%}
