import 'package:flutter/material.dart';
import 'package:{{ package }}/app.g.dart';

/// Served at `/about`: the folder gives the path (about/page.dart) and the class gives the
/// route's name (AboutPage becomes AboutRoute).
class AboutPage extends StatelessWidget {
  const AboutPage({super.key});

  @override
  Widget build(BuildContext context) => Center(
    child: Column(
      mainAxisSize: MainAxisSize.min,
      children: [
        const Text('Every folder under lib/app/ is a path.'),
        TextButton(
          onPressed: () => const HomeRoute().go(context),
          child: const Text('Home'),
        ),
      ],
    ),
  );
}
