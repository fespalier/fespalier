import 'package:flutter/material.dart';
import 'package:{{ package }}/app.g.dart';

/// Served at `/`: page.dart in lib/app/ is the home page. The route is named after the class
/// (HomePage becomes HomeRoute), and AboutRoute below is generated from lib/app/about/page.dart.
class HomePage extends StatelessWidget {
  const HomePage({super.key});

  @override
  Widget build(BuildContext context) => Center(
    child: Column(
      mainAxisSize: MainAxisSize.min,
      children: [
        const Text('Hello from fespalier'),
        TextButton(
          onPressed: () => const AboutRoute().go(context),
          child: const Text('About'),
        ),
      ],
    ),
  );
}
