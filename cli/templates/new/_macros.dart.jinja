{#- Helpers that lay Dart out the way `dart format` does (tall style, 80 columns), so a scaffolded
    file is already formatted whatever the names are. No macro prints a trailing newline. -#}

{#- `class Name extends Base {`: one line when it fits, else `extends` on the next line. -#}
{% macro classdecl(name, base) -%}
{% set one = "class " ~ name ~ " extends " ~ base ~ " {" -%}
{% if one|length <= 80 -%}
{{ one }}
{%- else -%}
{{ "class " ~ name ~ "\n    extends " ~ base ~ " {" }}
{%- endif -%}
{% endmacro %}

{#- A `const` constructor of a widget in a class body: one line when it fits, else one parameter
    per line. `params` are the named parameters, without the braces. -#}
{% macro ctor(name, params) -%}
{% set one = "  const " ~ name ~ "({" ~ params|join(", ") ~ "});" -%}
{% if one|length <= 80 -%}
{{ one }}
{%- else -%}
{{ "  const " ~ name ~ "({\n" }}{% for p in params %}{{ "    " ~ p ~ ",\n" }}{% endfor %}{{ "  });" }}
{%- endif -%}
{% endmacro %}

{#- `signature => expression;` at `indent` (a method): one line when it fits, else the expression
    on the next line, four columns further in. -#}
{% macro arrow(indent, signature, expression) -%}
{% set one = indent ~ signature ~ " => " ~ expression ~ ";" -%}
{% if one|length <= 80 -%}
{{ one }}
{%- else -%}
{{ indent ~ signature ~ " =>\n" ~ indent ~ "    " ~ expression ~ ";" }}
{%- endif -%}
{% endmacro %}

{#- A top-level function `head(positional, {named})tail => expression;`: on one line when it
    fits, else the expression on the next line, else (the signature itself is too long) one
    parameter per line, the expression after the closing parenthesis. -#}
{% macro func(head, positional, named, tail, expression) -%}
{% set inner = positional|join(", ") ~ (", " if positional and named else "") ~ ("{" ~ named|join(", ") ~ "}" if named else "") -%}
{% set sig = head ~ "(" ~ inner ~ ")" ~ tail -%}
{% if (sig ~ " => " ~ expression ~ ";")|length <= 80 -%}
{{ sig ~ " => " ~ expression ~ ";" }}
{%- elif (sig ~ " =>")|length <= 80 -%}
{{ sig ~ " =>\n    " ~ expression ~ ";" }}
{%- else -%}
{% set last = "})" ~ tail if named else ")" ~ tail -%}
{{ head ~ "(" ~ ("\n" if positional else "{\n") }}
{%- for p in positional -%}{{ "  " ~ p ~ (", {" if named and loop.last else ",") ~ "\n" }}{%- endfor -%}
{%- for p in named -%}{{ "  " ~ p ~ ",\n" }}{%- endfor -%}
{% if (last ~ " => " ~ expression ~ ";")|length <= 80 -%}
{{ last ~ " => " ~ expression ~ ";" }}
{%- else -%}
{{ last ~ " =>\n    " ~ expression ~ ";" }}
{%- endif -%}
{%- endif -%}
{% endmacro %}
