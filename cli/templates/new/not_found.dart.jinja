{% from "new/_macros.dart" import classdecl, ctor, func, arrow %}
import 'package:flutter/material.dart';

{% if function %}
{% if segs %}
/// The segments of this folder's path arrive as Strings, as the URL spells them.
{{ func("Widget notFound", [], ["required Uri uri"] + segs|map(attribute="string_param")|list, "", "Center(child: Text('Nothing at ${uri.path}'))") }}
{% else %}
{{ func("Widget notFound", [], ["required Uri uri"], "", "Center(child: Text('Nothing at ${uri.path}'))") }}
{% endif %}
{% else %}
/// Shown for a URL nothing matches under this folder, and for a segment of its routes
/// that doesn't parse. The segments of its path arrive as Strings, as the URL spells them.
{{ classdecl(stem ~ "NotFound", "StatelessWidget") }}
{% if segs %}
{{ ctor(stem ~ "NotFound", ["super.key", "required this.uri"] + segs|map(attribute="field")|list) }}

  final Uri uri;
{% for s in segs %}
  final String {{ s.name }};
{% endfor %}
{% else %}
{{ ctor(stem ~ "NotFound", ["super.key", "required this.uri"]) }}

  final Uri uri;
{% endif %}

  @override
{{ arrow("  ", "Widget build(BuildContext context)", "Center(child: Text('Nothing at ${uri.path}'))") }}
}
{% endif %}
