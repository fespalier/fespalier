# fsp telemetry reads this as .env (written once, never overwritten). Every value has this default
# in compose.yaml, so a missing .env changes nothing.
# OpenObserve's login. The password needs upper and lower case, a digit and a symbol, 8+ characters.
# It is set on the first start only: change it, then `fsp telemetry --reset`.
FSP_O2_EMAIL=dev@fespalier.local
FSP_O2_PASSWORD=Fespalier-local-1
FSP_GRAFANA_PASSWORD=Fespalier-local-1
# Ports on this computer.
FSP_OTLP_HTTP_PORT=4318
FSP_OTLP_GRPC_PORT=4317
FSP_O2_PORT=5080
FSP_GRAFANA_PORT=3000
# How long the dashboard importer waits for OpenObserve to answer, in seconds.
FSP_O2_WAIT=180
# 127.0.0.1: emulators, simulators, desktop and the web. 0.0.0.0: phones on your network
# (fsp telemetry --lan sets it for one run).
FSP_OTLP_BIND=127.0.0.1
# One more browser origin allowed to send OTLP (http://localhost:* and http://127.0.0.1:* always are).
FSP_OTLP_CORS_ORIGIN=http://localhost
