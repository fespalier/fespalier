      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fespalier-openobserve"
          },
          "expr": "sum(sum_over_time(fespalier_calls{fespalier_operation=\"data\", service_name=\"$service\", fespalier_data_state=\"error\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
