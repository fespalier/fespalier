{
  "uid": "fespalier-errors",
  "title": "fespalier · Errors",
  "description": "What broke, where, and with which error: failed checks, loads, actions and code downloads, uncaught errors, and native crashes.",
  "tags": [
    "fespalier"
  ],
  "editable": false,
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "fespalier",
      "type": "dashboards",
      "tags": [
        "fespalier"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "fespalier-openobserve"
        },
        "query": {
          "query": "label_values(fespalier_calls, service_name)",
          "refId": "service"
        },
        "refresh": 2,
        "includeAll": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What counts as a failure",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "A **failure** is a check (`guard.dart`, `redirect.dart`), a content load (`data.dart`), an action (`action.dart`) or a code download that threw. An **uncaught error** is one nothing caught. Colours as on App health: 🟢 none · 🟠 a few · 🔴 many."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "How many operations failed?",
      "description": "Checks, content loads, actions and code downloads that threw. Good: none. If not: the table below names each one with the file to open, such as a data.dart or action.dart.",
      "datasource": {
        "type": "prometheus",
        "uid": "fespalier-openobserve"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fespalier-openobserve"
          },
          "expr": "sum(sum_over_time(fespalier_calls{service_name=\"$service\", status_code=\"STATUS_CODE_ERROR\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Did anything throw an uncaught error?",
      "description": "Errors nothing caught (logged at ERROR or above). Good: none. If not: Errors lists them by type with the message; most come from a widget build or an unawaited Future.",
      "datasource": {
        "type": "prometheus",
        "uid": "fespalier-openobserve"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fespalier-openobserve"
          },
          "expr": "sum(sum_over_time(fespalier_app_errors{service_name=\"$service\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
