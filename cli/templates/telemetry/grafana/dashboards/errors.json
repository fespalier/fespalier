        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fespalier-openobserve"
          },
          "expr": "sum by (fespalier_operation) (sum_over_time(fespalier_calls{service_name=\"$service\", status_code=\"STATUS_CODE_ERROR\"}[$__interval]))",
          "legendFormat": "{{fespalier_operation}}",
          "instant": false,
          "range": true
