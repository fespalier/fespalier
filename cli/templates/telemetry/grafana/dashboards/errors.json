        "type": "prometheus",
        "uid": "fespalier-openobserve"
      },
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fespalier-openobserve"
          },
          "expr": "sum(sum_over_time(fespalier_calls{fespalier_operation=~\"guard|redirect\", service_name=\"$service\", fespalier_guard_decision=\"error\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
