    {
      "id": 4,
      "type": "stat",
      "title": "Did the app crash or freeze?",
      "description": "Native crashes and 'app not responding' freezes on Android and iOS. Good: none; even one is worth a look. If not: Errors has the time; read the device log.",
      "datasource": {
        "type": "prometheus",
        "uid": "fespalier-openobserve"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fespalier-openobserve"
          },
          "expr": "sum(sum_over_time(fespalier_app_crashes{service_name=\"$service\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
