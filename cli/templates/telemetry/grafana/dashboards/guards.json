          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fespalier-openobserve"
          },
          "expr": "sum by (fespalier_file, fespalier_route) (sum_over_time(fespalier_calls{fespalier_operation=~\"guard|redirect\", service_name=\"$service\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "fespalier-openobserve"
          },
          "expr": "sum by (fespalier_file, fespalier_route) (sum_over_time(fespalier_calls{fespalier_operation=~\"guard|redirect\", service_name=\"$service\", fespalier_guard_decision=\"redirect\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "fespalier-openobserve"
          },
          "expr": "sum by (fespalier_file, fespalier_route) (sum_over_time(fespalier_calls{fespalier_operation=~\"guard|redirect\", service_name=\"$service\", fespalier_guard_decision=\"error\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "fespalier-openobserve"
          },
          "expr": "sum by (fespalier_file, fespalier_route) (sum_over_time(fespalier_calls{fespalier_operation=~\"guard|redirect\", service_name=\"$service\", fespalier_guard_decision=\"skipped\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "fespalier-openobserve"
          },
          "expr": "histogram_quantile(0.95, sum by (le, fespalier_file, fespalier_route) (sum_over_time(fespalier_duration_bucket{fespalier_operation=~\"guard|redirect\", service_name=\"$service\", fespalier_async=\"true\"}[$__range])))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "options": {},
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "fespalier_file": 0,
              "fespalier_route": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6
            },
            "renameByName": {
              "fespalier_file": "guard",
              "fespalier_route": "route",
              "Value #A": "decisions",
              "Value #B": "denials",
              "Value #C": "errors",
              "Value #D": "skipped",
              "Value #E": "p95_ms"
            }
          }
        }
