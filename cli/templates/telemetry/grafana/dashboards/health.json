      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "fespalier_route": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            },
            "renameByName": {
              "fespalier_route": "Screen",
              "Value #A": "Views",
              "Value #B": "Open, slowest 5 %",
              "Value #C": "Content, slowest 5 %"
            }
          }
