            "uid": "fespalier-openobserve"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (sum_over_time(fespalier_duration_bucket{fespalier_operation=\"action\", service_name=\"$service\"}[$__range]))) and on() (sum(sum_over_time(fespalier_calls{fespalier_operation=\"action\", service_name=\"$service\"}[$__range])) >= 20)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 3000
              }
            ]
          },
          "links": [
            {
              "title": "Open Actions",
              "url": "/d/fespalier-actions?${__url_time_range}&${service:queryparam}"
            }
          ],
          "noValue": "Not enough data yet"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
