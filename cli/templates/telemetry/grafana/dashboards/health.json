    {
      "id": 11,
      "type": "table",
      "title": "What fails most?",
      "description": "The five things that failed most often, with the file to open. A Check is a guard.dart, Content a data.dart, an Action an action.dart.",
      "datasource": {
        "type": "prometheus",
        "uid": "fespalier-openobserve"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
