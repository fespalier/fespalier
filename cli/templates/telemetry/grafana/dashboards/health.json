    {
      "id": 10,
      "type": "table",
      "title": "Which screens are slowest?",
      "description": "The five screens that take longest to open. Content is the data.dart load that follows. If one is red: open Screens and check its guard.dart and data.dart rows.",
      "datasource": {
        "type": "prometheus",
        "uid": "fespalier-openobserve"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fespalier-openobserve"
          },
          "expr": "sum by (fespalier_route) (sum_over_time(fespalier_calls{fespalier_operation=\"navigate\", service_name=\"$service\", fespalier_navigation_outcome=\"ok\", fespalier_navigation_kind!=\"refresh\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "fespalier-openobserve"
          },
          "expr": "histogram_quantile(0.95, sum by (le, fespalier_route) (sum_over_time(fespalier_duration_bucket{fespalier_operation=\"navigate\", service_name=\"$service\", fespalier_navigation_outcome!=\"superseded\"}[$__range])))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "fespalier-openobserve"
          },
          "expr": "histogram_quantile(0.95, sum by (le, fespalier_route) (sum_over_time(fespalier_duration_bucket{fespalier_operation=\"data\", service_name=\"$service\", fespalier_data_state=~\"data|error\"}[$__range])))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
