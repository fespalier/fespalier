{
  "uid": "fespalier-screens",
  "title": "fespalier · Screens",
  "description": "Are screens opening fast, where do people go, and what slows a screen down: its checks (guard.dart), its content (data.dart) or its code (deferred pages)?",
  "tags": [
    "fespalier"
  ],
  "editable": false,
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "fespalier",
      "type": "dashboards",
      "tags": [
        "fespalier"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "fespalier-openobserve"
        },
        "query": {
          "query": "label_values(fespalier_calls, service_name)",
          "refId": "service"
        },
        "refresh": 2,
        "includeAll": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What a screen is",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "A **screen** is a route: a `page.dart` under `lib/app/`. **Open** runs from the tap to its first frame (redirects and guards included). **Content** is the `data.dart` load that follows. Colours as on App health: 🟢 good · 🟠 needs attention · 🔴 bad · grey: not enough data yet."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "How many screens were viewed?",
      "description": "Screens that opened in this time range (back and tab switches included, refreshes not). It tells you how much the other tiles are based on.",
      "datasource": {
        "type": "prometheus",
        "uid": "fespalier-openobserve"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fespalier-openobserve"
          },
          "expr": "sum(sum_over_time(fespalier_calls{fespalier_operation=\"navigate\", service_name=\"$service\", fespalier_navigation_outcome=\"ok\", fespalier_navigation_kind!=\"refresh\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Do screens open quickly?",
      "description": "Time from a tap to the new screen's first frame, for the slowest 5 % of opens. Good: under 300 ms. If not: open Screens; slow ones usually wait on a guard.dart or build too much in page.dart.",
      "datasource": {
        "type": "prometheus",
        "uid": "fespalier-openobserve"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fespalier-openobserve"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (sum_over_time(fespalier_duration_bucket{fespalier_operation=\"navigate\", service_name=\"$service\", fespalier_navigation_outcome!=\"superseded\"}[$__range]))) and on() (sum(sum_over_time(fespalier_calls{fespalier_operation=\"navigate\", service_name=\"$service\", fespalier_navigation_outcome!=\"superseded\"}[$__range])) >= 20)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "noValue": "Not enough data yet"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Does content load quickly?",
      "description": "How long data.dart takes to deliver a screen's content, slowest 5 %. Good: under 1 s. If not: Screens lists each data.dart; cache it (dataCache), load less, or show what you have first.",
      "datasource": {
        "type": "prometheus",
        "uid": "fespalier-openobserve"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fespalier-openobserve"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (sum_over_time(fespalier_duration_bucket{fespalier_operation=\"data\", service_name=\"$service\", fespalier_data_state=~\"data|error\"}[$__range]))) and on() (sum(sum_over_time(fespalier_calls{fespalier_operation=\"data\", service_name=\"$service\", fespalier_data_state=~\"data|error\"}[$__range])) >= 20)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 3000
              }
            ]
          },
          "noValue": "Not enough data yet"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "How often does a link lead nowhere?",
      "description": "Share of navigations that matched no route and showed not_found.dart. Good: under 1 %. If not: check the links you build by hand; typed routes (AppRoutes) cannot go wrong.",
      "datasource": {
        "type": "prometheus",
        "uid": "fespalier-openobserve"
      },
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fespalier-openobserve"
          },
          "expr": "100 * (sum(sum_over_time(fespalier_calls{fespalier_operation=\"navigate\", service_name=\"$service\", fespalier_navigation_outcome!=\"superseded\"}[$__range])) - sum(sum_over_time(fespalier_calls{fespalier_operation=\"navigate\", service_name=\"$service\", fespalier_navigation_outcome=\"ok\"}[$__range]))) / sum(sum_over_time(fespalier_calls{fespalier_operation=\"navigate\", service_name=\"$service\", fespalier_navigation_outcome!=\"superseded\"}[$__range])) and on() (sum(sum_over_time(fespalier_calls{fespalier_operation=\"navigate\", service_name=\"$service\", fespalier_navigation_outcome!=\"superseded\"}[$__range])) >= 20)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "noValue": "Not enough data yet"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "How long does each screen take?",
      "description": "Every screen with its typical (p50) and slowest-5 % (p95) open time, and its content load. Sort by any column. A red Open usually means a slow guard.dart or a heavy page.dart build.",
