          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT fespalier_action_name AS action, fespalier_file AS file, COUNT(*) AS runs, 100.0 * SUM(CASE WHEN fespalier_operation = 'action' AND fespalier_action_result = 'error' THEN 1 ELSE 0 END) / NULLIF(SUM(CASE WHEN fespalier_operation = 'action' THEN 1 ELSE 0 END), 0) AS failed_pct, approx_percentile_cont(duration, 0.5) / 1000.0 AS p50_ms, approx_percentile_cont(duration, 0.95) / 1000.0 AS p95_ms FROM \"default\" WHERE fespalier_operation = 'action' AND service_name = '$service' GROUP BY action, file ORDER BY failed_pct DESC, runs DESC",
