        {
          "id": "panel_failed_over_time",
          "type": "bar",
          "title": "When did things fail?",
          "description": "Failures over time, by kind.",
          "config": {
            "show_legends": true,
            "legends_position": null,
            "unit": null,
            "decimals": 0
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) AS t, CASE fespalier_operation WHEN 'navigate' THEN 'Screen open' WHEN 'guard' THEN 'Check (guard.dart)' WHEN 'redirect' THEN 'Redirect (redirect.dart)' WHEN 'data' THEN 'Content load (data.dart)' WHEN 'action' THEN 'Action (action.dart)' WHEN 'deferred' THEN 'Code download (deferred page)' WHEN 'auth' THEN 'Session (sign-in, refresh, sign-out)' ELSE fespalier_operation END AS operation, COUNT(*) AS failed FROM \"default\" WHERE span_status = 'ERROR' AND fespalier_operation IS NOT NULL AND service_name = '$service' GROUP BY t, operation ORDER BY t",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [
                  {
                    "label": "Time",
                    "alias": "t",
                    "column": "t",
                    "color": null
                  }
                ],
                "y": [
                  {
                    "label": "Failed",
                    "alias": "failed",
                    "column": "failed",
                    "color": null
                  }
                ],
                "z": [],
                "breakdown": [
                  {
                    "label": "Kind",
                    "alias": "operation",
                    "column": "operation",
                    "color": null
                  }
                ],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": ""
              }
            }
          ],
