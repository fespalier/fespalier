          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT fespalier_file AS guard, fespalier_route AS route, COUNT(*) AS decisions, SUM(CASE WHEN fespalier_guard_decision = 'redirect' THEN 1 ELSE 0 END) AS denials, SUM(CASE WHEN fespalier_guard_decision = 'error' THEN 1 ELSE 0 END) AS errors, SUM(CASE WHEN fespalier_guard_decision = 'skipped' THEN 1 ELSE 0 END) AS skipped, approx_percentile_cont(CASE WHEN fespalier_async = 'true' THEN duration END, 0.95) / 1000.0 AS p95_ms FROM \"default\" WHERE fespalier_operation IN ('guard', 'redirect') AND service_name = '$service' GROUP BY guard, route ORDER BY decisions DESC",
