            {
              "query": "SELECT fespalier_route AS route, SUM(CASE WHEN fespalier_operation = 'navigate' AND fespalier_navigation_outcome = 'ok' AND fespalier_navigation_kind <> 'refresh' THEN 1 ELSE 0 END) AS views, approx_percentile_cont(CASE WHEN fespalier_operation = 'navigate' AND fespalier_navigation_outcome <> 'superseded' THEN duration END, 0.5) / 1000.0 AS open_p50, approx_percentile_cont(CASE WHEN fespalier_operation = 'navigate' AND fespalier_navigation_outcome <> 'superseded' THEN duration END, 0.95) / 1000.0 AS open_p95, approx_percentile_cont(CASE WHEN fespalier_operation = 'data' AND fespalier_data_state IN ('data', 'error') THEN duration END, 0.95) / 1000.0 AS content_p95 FROM \"default\" WHERE fespalier_route IS NOT NULL AND service_name = '$service' GROUP BY route ORDER BY open_p95 DESC NULLS LAST",
