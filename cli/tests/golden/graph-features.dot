digraph routes {
  rankdir=TB;
  node [shape=box];
  subgraph cluster_rootnav {
    label="root navigator";
    style=dashed;
    subgraph cluster_b0 {
      label="layout layout.dart";
      style=rounded;
      n0 [label="/\nHomeRoute"];
      subgraph cluster_b1 {
        label="layout (account)/layout.dart";
        style=rounded;
        n1 [label="/profile\nProfileRoute"];
        n2 [label="/settings\nSettingsRoute"];
      }
      n3 [label="/admin\nAdminRoute\n(guard)"];
      n4 [label="/inbox\nInboxRoute\n(guard)"];
      n5 [label="/free\nFreeRoute"];
      n6 [label="/pro\nProPlanRoute"];
      n7 [label="/catalog\nCatalogRoute\n(data)"];
      n8 [label="/catalog/:productId\nProductDetailRoute\n(data)"];
      n9 [label="/catalog/:productId/reviews\nReviewsRoute\n(data)"];
      n10 [label="/counter\nCounterRoute\n(data)"];
      n11 [label="/docs\nDocsIndexRoute"];
      n12 [label="/docs/new\nNewDocRoute"];
      n13 [label="/docs/*rest\nDocsRoute"];
      n14 [label="/feed\nFeedRoute"];
      n15 [label="/files\nFilesRoute"];
      n16 [label="/guide\nGuideRoute\nde /f&#252;hrer, ru /&#1088;&#1091;&#1082;&#1086;&#1074;&#1086;&#1076;&#1089;&#1090;&#1074;&#1086;"];
      n17 [label="/help\nHelpRoute\nfr /aide, de /hilfe"];
      n18 [label="/help/contact\nContactRoute\nfr /aide/contact, de /hilfe/kontakt"];
      n19 [label="/help/:topic\nHelpTopicRoute\nfr /aide/:topic, de /hilfe/:topic"];
      n20 [label="/help/:topic/examples\nHelpExamplesRoute\nfr /aide/:topic/exemples, de /hilfe/:topic/beispiele"];
      n21 [label="/login\nLoginRoute"];
      n22 [label="/old-search\nOldSearchRoute\n(redirect)", style=dashed];
      n23 [label="/photos\nPhotosRoute"];
      n24 [label="/photos/share\nShareSheetRoute\n(present, root)"];
      n25 [label="/photos/share/terms\nTermsRoute\n(root)"];
      n26 [label="/photos/sort\nSortRoute"];
      n27 [label="/photos/upload\nUploadRoute"];
      n28 [label="/photos/:id\nPhotoRoute"];
      subgraph cluster_b2 {
        label="layout reports/layout.dart (data)";
        style=rounded;
        n29 [label="/reports/monthly\nMonthlyReportRoute"];
        n30 [label="/reports/yearly\nYearlyReportRoute"];
      }
      n31 [label="/search\nSearchRoute\n(data)"];
      n32 [label="/ticks\nTicksRoute\n(data)"];
      n33 [label="/:slug\nSlugRoute"];
      subgraph cluster_b3 {
        label="layout notes/layout.dart";
        style=rounded;
        n34 [label="/notes/:id\nNoteRoute\n(guard)"];
      }
      n35 [label="/old-shops/:shop\nOldShopsShopRoute\n(redirect)", style=dashed];
      n36 [label="/orders/:id\nOrderRoute"];
      n37 [label="/orders/:id/refund\nRefundRoute\n(data, action, guard)"];
      n38 [label="/orders/:id/refund/receipt\nReceiptRoute"];
      n39 [label="/orders/:id/refund/confirm\nConfirmRefundRoute\n(guard, sibling)"];
      n40 [label="/remount/location/:id\nRemountLocationRoute"];
      n41 [label="/remount/never/:id\nRemountNeverRoute"];
      n42 [label="/remount/segments/:id\nRemountSegmentsRoute"];
      n43 [label="/shop/:category\nCategoryShopRoute\nfr /boutique/:category, de /laden/:category\n(data)"];
      subgraph cluster_b4 {
        label="layout shops/$shop/layout.dart (guard)";
        style=rounded;
        n44 [label="/shops/:shop\nShopRoute\n(guard)"];
        n45 [label="/shops/:shop/items/:id\nItemRoute\n(data)"];
      }
      subgraph cluster_b5 {
        label="layout teams/$teamId/layout.dart (data)";
        style=rounded;
        n46 [label="/teams/:teamId/members\nMembersRoute"];
        n47 [label="/teams/:teamId/members/:member\nMemberRoute\n(data)"];
        n48 [label="/teams/:teamId/settings\nTeamSettingsRoute"];
      }
      n49 [label="/browse/*categories\nBrowseRoute\n(data)"];
      n50 [label="/compare/*ids\nCompareRoute\n(data)"];
      n51 [label="/files/*path?\nFilesRoute"];
      n52 [label="/wiki/*article\nWikiRoute\n(data)"];
    }
  }
