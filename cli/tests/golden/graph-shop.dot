digraph routes {
  rankdir=TB;
  node [shape=box];
  subgraph cluster_rootnav {
    label="root navigator";
    style=dashed;
    subgraph cluster_b0 {
      label="layout layout.dart";
      style=rounded;
      n0 [label="/\nHomeRoute"];
      n1 [label="/cart\nCartRoute"];
      n2 [label="/checkout\nCheckoutRoute\n(guard)"];
      n3 [label="/products\nProductsRoute\n(data)"];
      n4 [label="/products/:id\nProductRoute\n(data)"];
      n5 [label="/greet/:name\nGreetRoute"];
    }
  }
  n0 -> n1;
  n0 -> n2;
  n0 -> n3;
  n0 -> n5;
  n3 -> n4;
}
