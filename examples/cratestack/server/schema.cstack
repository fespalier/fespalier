transport rpc

datasource db {
  provider = "none"
}

type Jwk {
  kty String
  crv String
  x String
  y String
}

type SendCodeArgs {
  phone String
}

type CodeSent {
  phone String
}

type BeginEnrolmentArgs {
  phone String
  otp String
  ambient Jwk
  userPresent Jwk?
}

type EnrolmentChallenges {
  enrolmentId String
  ambient String
  userPresent String?
}

type ConfirmEnrolmentArgs {
  enrolmentId String
  ambient String
  userPresent String?
}

type EnrolledDevice {
  deviceId String
  userId String
  phone String
  ambient String
  userPresent String?
}

type BeginRenewalArgs {
  deviceId String
  role String
}

type RenewalChallenge {
  challengeId String
  challenge String
}

type ConfirmRenewalArgs {
  challengeId String
  signature String
}

type Renewed {
  attestation String
}

type RevokeArgs {
  deviceId String
}

type Revoked {
  deviceId String
}

type Account {
  userId String
  phone String
  deviceId String
  signedWith String
}

type NoArgs {
  unused Int?
}

type Order {
  id Int
  item String
  quantity Int
  status String
}

type OrderList {
  orders Order[]
}

type ListOrdersArgs {
  limit Int?
}

type GetOrderArgs {
  id Int
}

type PlaceOrderArgs {
  item String
  quantity Int
}

type PayOrderArgs {
  id Int
}

// The public procedures: a device that has no session calls them unsigned, so the provider reads
// it as anonymous and these policies let it in. Authkestra's enrolment checks the second factor
// before it issues a challenge, so the code is asked for first (sendEnrolmentCode), and sent with
// the keys (beginEnrolment); confirmEnrolment carries the challenge signatures only.
mutation procedure sendEnrolmentCode(args: SendCodeArgs): CodeSent
  @allow(true)

mutation procedure beginEnrolment(args: BeginEnrolmentArgs): EnrolmentChallenges
  @allow(true)

mutation procedure confirmEnrolment(args: ConfirmEnrolmentArgs): EnrolledDevice
  @allow(true)

mutation procedure beginRenewal(args: BeginRenewalArgs): RenewalChallenge
  @allow(true)

mutation procedure confirmRenewal(args: ConfirmRenewalArgs): Renewed
  @allow(true)

mutation procedure revokeDevice(args: RevokeArgs): Revoked
  @allow(auth() != null)

procedure account(args: NoArgs): Account
  @allow(auth() != null)

procedure listOrders(args: ListOrdersArgs): OrderList
  @allow(auth() != null)

procedure getOrder(args: GetOrderArgs): Order
  @allow(auth() != null)

mutation procedure placeOrder(args: PlaceOrderArgs): Order
  @allow(auth() != null)

// Paying moves money, so it needs a user-presence test (RFC 8176 `user`), which only a signature
// by the device's user-present key proves (`principal_of` in src/auth.rs maps the key role to `amr`).
// Any other signed caller is refused with RFC 9470's step-up 401 before the procedure runs; the
// app's session signs the request again with the user-present key and sends it once more.
mutation procedure payOrder(args: PayOrderArgs): Order
  @allow(auth() != null)
  @authn(amr: ["user"])
