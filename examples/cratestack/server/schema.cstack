transport rpc

datasource db {
  provider = "none"
}

type Jwk {
  kty String
  crv String
  x String
  y String
}

type BeginEnrolmentArgs {
  phone String
  ambient Jwk
  userPresent Jwk?
}

type EnrolmentChallenges {
  enrolmentId String
  ambient String
  userPresent String?
}

type ConfirmEnrolmentArgs {
  enrolmentId String
  otp String
  ambient String
  userPresent String?
}

type EnrolledDevice {
  deviceId String
  userId String
  phone String
  ambient String
  userPresent String?
}

type BeginRenewalArgs {
  deviceId String
  role String
}

type RenewalChallenge {
  challengeId String
  challenge String
}

type ConfirmRenewalArgs {
  challengeId String
  signature String
}

type Renewed {
  attestation String
}

type RevokeArgs {
  deviceId String
}

type Revoked {
  deviceId String
}

type Account {
  userId String
  phone String
  deviceId String
  signedWith String
}

type NoArgs {
  unused Int?
}

type Order {
  id Int
  item String
  quantity Int
  status String
}

type OrderList {
  orders Order[]
}

type ListOrdersArgs {
  limit Int?
}

type GetOrderArgs {
  id Int
}

type PlaceOrderArgs {
  item String
  quantity Int
}

type PayOrderArgs {
  id Int
}

mutation procedure beginEnrolment(args: BeginEnrolmentArgs): EnrolmentChallenges
  @allow(true)

mutation procedure confirmEnrolment(args: ConfirmEnrolmentArgs): EnrolledDevice
  @allow(true)

mutation procedure beginRenewal(args: BeginRenewalArgs): RenewalChallenge
  @allow(true)

mutation procedure confirmRenewal(args: ConfirmRenewalArgs): Renewed
  @allow(true)

mutation procedure revokeDevice(args: RevokeArgs): Revoked
  @allow(auth() != null)

procedure account(args: NoArgs): Account
  @allow(auth() != null)

procedure listOrders(args: ListOrdersArgs): OrderList
  @allow(auth() != null)

procedure getOrder(args: GetOrderArgs): Order
  @allow(auth() != null)

mutation procedure placeOrder(args: PlaceOrderArgs): Order
  @allow(auth() != null)

mutation procedure payOrder(args: PayOrderArgs): Order
  @allow(auth() != null)
