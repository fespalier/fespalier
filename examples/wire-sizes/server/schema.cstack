// The wire-sizes example's contract. No database: the notes live in memory.
//
// Unlike `examples/cose`, **the same server serves plain JSON, plain CBOR and COSE_Sign1 CBOR**,
// so one payload can be measured three ways through one code path. Which one a call travels as is
// decided by the codec the router was built with and, for COSE, by the envelope layer.

transport rpc

datasource db {
  provider = "none"
}

type RegisterArgs {
  x String
  y String
}

type DeviceView {
  kid String
  thumbprint String
}

type ListArgs {
  limit Int?
}

type NoteArgs {
  text String
}

type Note {
  id Int
  text String
}

type NoteList {
  notes Note[]
}

mutation procedure registerDevice(args: RegisterArgs): DeviceView
  @allow(true)

procedure listNotes(args: ListArgs): NoteList
  @allow(auth() != null)

mutation procedure addNote(args: NoteArgs): Note
  @allow(auth() != null)
