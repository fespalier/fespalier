{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "draft": true,
      "force-tag-creation": true,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance"
        },
        {
          "type": "deps",
          "section": "Dependencies"
        },
        {
          "type": "revert",
          "section": "Reverts"
        },
        {
          "type": "refactor",
          "section": "Refactoring"
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "test",
          "section": "Tests"
        },
        {
          "type": "build",
          "section": "Build System"
        },
        {
          "type": "ci",
          "section": "Continuous Integration"
        },
        {
          "type": "chore",
          "section": "Chores"
        },
        {
          "type": "style",
          "section": "Styles",
          "hidden": true
        }
      ],
      "extra-files": [
        {
          "type": "generic",
          "path": "cli/Cargo.toml"
        },
        {
          "type": "generic",
          "path": "packages/fespalier/pubspec.yaml"
        },
        {
          "type": "generic",
          "path": "packages/fespalier/lib/src/version.dart"
        },
        {
          "type": "generic",
          "path": "packages/fespalier_otel/pubspec.yaml"
        },
        {
          "type": "generic",
          "path": "packages/fespalier_otel/README.md"
        },
        {
          "type": "generic",
          "path": "packages/fespalier_auth/pubspec.yaml"
        },
        {
          "type": "generic",
          "path": "packages/fespalier_auth/README.md"
        },
        {
          "type": "generic",
          "path": "packages/fespalier_sign_keypair/pubspec.yaml"
        },
        {
          "type": "generic",
          "path": "packages/fespalier_sign_keypair/README.md"
        },
        {
          "type": "generic",
          "path": "packages/fespalier_adaptive/pubspec.yaml"
        },
        {
          "type": "generic",
          "path": "packages/fespalier_adaptive/README.md"
        },
        {
          "type": "generic",
          "path": "packages/fespalier_flags/pubspec.yaml"
        },
        {
          "type": "generic",
          "path": "packages/fespalier_flags/README.md"
        },
        {
          "type": "generic",
          "path": "packages/fespalier_storage/pubspec.yaml"
        },
        {
          "type": "generic",
          "path": "packages/fespalier_storage/README.md"
        },
        {
          "type": "generic",
          "path": "packages/fespalier_connectivity/pubspec.yaml"
        },
        {
          "type": "generic",
          "path": "packages/fespalier_connectivity/README.md"
        },
        {
          "type": "generic",
          "path": "packages/fespalier_image/pubspec.yaml"
        },
        {
          "type": "generic",
          "path": "packages/fespalier_image/README.md"
